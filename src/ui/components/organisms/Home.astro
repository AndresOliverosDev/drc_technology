---
---

<section class="relative min-h-[calc(100vh-10rem)] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 overflow-hidden mesh-gradient grid-pattern">
  <!-- Subtle ambient glow backdrops -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10 space-y-10">
    
    <!-- Central Brand Logo Presentation -->
    <div class="flex justify-center">
      <div class="relative w-44 sm:w-56 aspect-square flex items-center justify-center group">
        <div class="absolute -inset-4 bg-gradient-to-tr from-cyan-500/20 to-amber-500/15 rounded-full blur-2xl group-hover:bg-cyan-500/30 transition-all duration-700 pointer-events-none"></div>
        <img
          src="/images/logo.png"
          alt="DRC Technology"
          class="relative w-full h-full object-contain filter drop-shadow-[0_0_35px_rgba(6,182,212,0.45)] transition-transform duration-500 hover:scale-105"
        />
      </div>
    </div>

    <!-- Company Information -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-300 text-xs font-mono tracking-widest uppercase backdrop-blur-md">
        <span>Telecomunicaciones &bull; Infraestructura Crítica</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold font-heading text-white tracking-tight leading-tight">
        DRC <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-amber-400 bg-clip-text text-transparent glow-cyan">Technology</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Soluciones integrales de conectividad de alta disponibilidad, despliegue de fibra óptica y servicios de infraestructura tecnológica para entornos empresariales de misión crítica.
      </p>
    </div>

    <!-- Core Highlights / Company Details -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 text-left">
      <div class="glass-panel p-5 rounded-xl border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
        <p class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1">Conectividad</p>
        <h3 class="text-base font-bold text-white font-heading">Fibra Óptica & Transporte</h3>
        <p class="text-xs text-slate-400 mt-1">Enlaces dedicados de alta velocidad con redundancia de ruta.</p>
      </div>

      <div class="glass-panel p-5 rounded-xl border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
        <p class="text-xs font-mono text-amber-400 uppercase tracking-wider mb-1">Infraestructura</p>
        <h3 class="text-base font-bold text-white font-heading">Centros de Datos</h3>
        <p class="text-xs text-slate-400 mt-1">Espacios optimizados con altos estándares de energía y climatización.</p>
      </div>

      <div class="glass-panel p-5 rounded-xl border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
        <p class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1">Disponibilidad</p>
        <h3 class="text-base font-bold text-white font-heading">Soporte & NOC 24/7</h3>
        <p class="text-xs text-slate-400 mt-1">Monitoreo continuo y acuerdos de nivel de servicio (SLA) exigentes.</p>
      </div>
    </div>

  </div>
</section>
