---
---

<section class="relative overflow-hidden py-20 lg:py-32 mesh-gradient grid-pattern">
  <!-- Subtle ambient glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-300 text-xs font-mono uppercase tracking-widest backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>SEC-09 Standard &bull; Carrier-Grade Telecom</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight font-heading text-white leading-[1.1]">
          Engineered for <br />
          <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-amber-400 bg-clip-text text-transparent glow-cyan">
            Mission-Critical
          </span> <br />
          Digital Infrastructure
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          DRC Technology delivers ultra-low latency optical transport, carrier-neutral dark fiber backbones, and Tier-certified critical data systems for high-throughput enterprises.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#solutions"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-white bg-gradient-to-r from-cyan-600 via-cyan-500 to-sky-500 hover:from-cyan-500 hover:to-sky-400 shadow-xl shadow-cyan-500/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-cyan-500/40"
          >
            Explore Infrastructure
          </a>
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-slate-200 glass-panel hover:bg-slate-800/80 border border-slate-700/80 hover:border-cyan-500/40 transition-all duration-300 hover:-translate-y-0.5"
          >
            Request Architecture Review
          </a>
        </div>

        <!-- Key Metrics Strip -->
        <div class="pt-8 border-t border-slate-800/80 grid grid-cols-3 gap-6 text-center lg:text-left">
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-heading">99.999%</p>
            <p class="text-xs text-slate-400 uppercase tracking-wider font-mono">Carrier SLA</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-white font-heading">&lt; 1.8ms</p>
            <p class="text-xs text-slate-400 uppercase tracking-wider font-mono">DWDM Latency</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-amber-400 font-heading">400G+</p>
            <p class="text-xs text-slate-400 uppercase tracking-wider font-mono">Dense Backbone</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Logo Emblem Showcase -->
      <div class="lg:col-span-5 flex justify-center items-center relative">
        <!-- Glow Backdrops -->
        <div class="absolute -inset-4 bg-gradient-to-r from-cyan-500/20 to-amber-500/20 rounded-full blur-2xl"></div>

        <div class="relative w-72 sm:w-96 aspect-square rounded-3xl p-3 glass-panel border border-cyan-500/30 shadow-2xl shadow-cyan-950/80 flex items-center justify-center group">
          <!-- Ambient animated border ring -->
          <div class="absolute inset-0 rounded-3xl border border-cyan-400/20 group-hover:border-cyan-400/50 transition-colors duration-500 pointer-events-none"></div>

          <!-- The Emblem -->
          <div class="relative w-full h-full rounded-2xl overflow-hidden bg-slate-950 flex items-center justify-center p-2">
            <img 
              src="/images/logo.png" 
              alt="DRC Technology Official Emblem" 
              class="w-full h-full object-contain rounded-2xl filter drop-shadow-[0_0_25px_rgba(6,182,212,0.35)] transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <!-- Bottom Floating Badge -->
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full glass-panel border border-amber-500/40 bg-slate-900/90 text-amber-300 text-xs font-mono tracking-widest whitespace-nowrap shadow-lg flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>HARDWARE SEC-09 NODE</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
