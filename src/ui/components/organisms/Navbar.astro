---
---

<header class="w-full glass-panel border-b border-slate-800/80 sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
          <img 
            src="/images/logo.png" 
            alt="DRC Technology" 
            class="w-full h-full object-contain filter drop-shadow-[0_0_12px_rgba(6,182,212,0.4)]" 
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-wider font-heading text-white flex items-center gap-1.5">
            DRC <span class="text-cyan-400 text-xs font-semibold tracking-wider px-2 py-0.5 rounded-md bg-cyan-950/70 border border-cyan-800/50">TECHNOLOGY</span>
          </span>
          <span class="text-[10px] tracking-widest text-slate-400 font-mono uppercase">Infraestructura Crítica</span>
        </div>
      </a>

      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/80 border border-slate-800 text-xs text-slate-300 font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="hidden sm:inline">Sistema Operativo</span>
      </div>
    </div>
  </div>
</header>
