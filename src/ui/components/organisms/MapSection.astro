---
// MapSection.astro - Enterprise Dark Architectural Map Organism Component
const technicalVisitWhatsApp = 'https://wa.me/573502049578?text=Hola%20DR.C%20Technology,%20solicito%20visita%20t%C3%A9cnica%20corporativa';
---

<section 
  id="cobertura" 
  class="snap-section relative w-full h-[100dvh] min-h-[100dvh] py-3 sm:py-6 lg:py-8 px-3 sm:px-6 lg:px-12 bg-black text-white overflow-hidden border-t-0 select-none flex flex-col justify-between"
>
  <!-- Backward compatibility anchor for navigation menu -->
  <div id="infraestructura" class="absolute -top-12 left-0 w-0 h-0 pointer-events-none"></div>

  <!-- Fused Background Image: Continuous extension of the Hero image -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <img
      src="/images/hero-bg.jpg"
      alt=""
      class="w-full h-full object-cover object-bottom filter brightness-[0.28] contrast-125 transform scale-[1.02]"
    />
  </div>

  <!-- Pure Black Overlays matching Hero style for seamless visual fusion -->
  <div class="absolute inset-0 z-10 bg-black/80 backdrop-blur-[1px] pointer-events-none"></div>
  <div class="absolute inset-0 z-10 bg-gradient-to-b from-black via-black/40 to-black/90 pointer-events-none"></div>
  <div class="absolute inset-0 z-10 bg-[radial-gradient(#1E293B_1px,transparent_1px)] [background-size:24px_24px] opacity-15 pointer-events-none"></div>

  <!-- Top Safe Touch Header: Minimalist "Desliza" instruction -->
  <header 
    id="subterranean-top-handle" 
    class="relative z-20 w-full max-w-7xl mx-auto flex items-center justify-center py-2 cursor-pointer select-none group"
    title="Desliza para subir"
  >
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/70 group-hover:text-white group-hover:border-white/20 transition-all text-xs font-mono tracking-widest uppercase">
      <svg class="w-3.5 h-3.5 text-white/70 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
      <span>Desliza para subir</span>
    </div>
  </header>

  <!-- Central Map Stage Container (Constrained on mobile to preserve touch gutters) -->
  <div class="relative z-10 max-w-7xl mx-auto w-full my-auto">
    <div class="relative rounded-xl sm:rounded-2xl border border-white/10 bg-[#0A0F1D]/85 overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.85)] backdrop-blur-xl flex flex-col h-[62vh] sm:h-auto max-h-[750px]">
      <!-- Top HUD: Panel de Operaciones -->
      <div class="px-3 py-2 sm:px-5 sm:py-3.5 bg-slate-950/85 border-b border-white/10 backdrop-blur-md flex flex-wrap items-center justify-between gap-2 sm:gap-4 shrink-0">
        <!-- HUD Left: Operation Pulse -->
        <div class="flex items-center gap-2 sm:gap-3">
          <span class="relative flex h-2 w-2 sm:h-2.5 sm:w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 sm:h-2.5 sm:w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-[11px] sm:text-xs font-mono font-medium tracking-wide uppercase text-slate-300">
            Operación Nacional Activa
          </span>
          <span class="hidden sm:inline text-xs text-slate-600 font-mono">•</span>
          <span class="hidden sm:inline text-[11px] font-mono text-slate-500">
            NOC Bogotá Chapinero
          </span>
        </div>

        <!-- HUD Right: Corporate Pill Buttons -->
        <div class="flex items-center gap-1.5 sm:gap-2 text-[10px] sm:text-xs font-mono">
          <button 
            type="button" 
            id="btn-focus-hq"
            class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-slate-200 bg-blue-600/20 border border-blue-500/40 hover:bg-blue-600/30 hover:border-blue-500/60 transition-all font-medium flex items-center gap-1 sm:gap-1.5 shadow-sm"
          >
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Oficina Principal (3D)</span>
          </button>

          <button 
            type="button" 
            id="btn-focus-national"
            class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-slate-300 bg-slate-900 border border-white/10 hover:bg-slate-800 hover:text-white hover:border-white/20 transition-all font-medium flex items-center gap-1 sm:gap-1.5"
          >
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Cobertura</span>
          </button>

          <button 
            type="button" 
            id="btn-reset-view"
            class="px-2 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-slate-400 bg-slate-900 border border-white/10 hover:bg-slate-800 hover:text-white hover:border-white/20 transition-all font-medium flex items-center gap-1 sm:gap-1.5"
            title="Restablecer Vista"
          >
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="hidden sm:inline">Restablecer</span>
          </button>
        </div>
      </div>

      <!-- Map Canvas Mounting Element (44vh on mobile to leave generous touch space) -->
      <div id="maplibre-canvas" class="w-full flex-1 min-h-[220px] h-[44vh] sm:h-[580px] lg:h-[660px] bg-[#040711]"></div>

      <!-- Card Corporativa de Información (Auto-deployed / Interactive Info Box) -->
      <div 
        id="corporate-info-box" 
        class="absolute bottom-2 left-2 right-2 sm:right-auto sm:bottom-5 sm:left-5 z-20 max-w-sm sm:w-96 rounded-xl border border-white/10 bg-slate-900/95 p-3 sm:p-4 text-slate-100 shadow-2xl backdrop-blur-xl transition-all duration-500 opacity-0 translate-y-4 pointer-events-none max-h-[calc(100%-3rem)] overflow-y-auto"
        style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);"
      >
        <!-- Top accent corporate line -->
        <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-blue-500 to-transparent"></div>

        <!-- Header: Badge & Close Button -->
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider bg-blue-600/20 text-blue-300 border border-blue-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            OFICINA PRINCIPAL
          </span>
          <button 
            type="button" 
            id="btn-close-infobox" 
            class="text-slate-400 hover:text-white transition-colors p-1"
            aria-label="Cerrar ficha informativa"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Title & Location -->
        <h3 class="text-sm sm:text-base font-semibold text-white tracking-tight font-heading mb-0.5">
          DR.C Technology — Oficina Principal
        </h3>
        <p class="text-xs text-blue-400 flex items-center gap-1 mb-1.5 font-mono">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Chapinero, Bogotá D.C., Colombia
        </p>

        <!-- Subtext -->
        <p class="text-[11px] sm:text-xs text-slate-300 leading-relaxed mb-2.5 font-light">
          Centro de operaciones técnicas y consultoría de software. Sede central corporativa para gestión de red y proyectos de misión crítica.
        </p>

        <!-- Services Chips -->
        <div class="mb-3">
          <div class="text-[9px] sm:text-[10px] font-mono uppercase tracking-wider text-slate-400 mb-1.5">
            Servicios Habilitados:
          </div>
          <div class="flex flex-wrap gap-1 sm:gap-1.5">
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-medium bg-slate-800/80 text-slate-200 border border-white/5">
              Infraestructura
            </span>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-medium bg-slate-800/80 text-slate-200 border border-white/5">
              Redes
            </span>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-medium bg-slate-800/80 text-slate-200 border border-white/5">
              CCTV
            </span>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-medium bg-slate-800/80 text-slate-200 border border-white/5">
              Detección de Incendios
            </span>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-medium bg-slate-800/80 text-slate-200 border border-white/5">
              Consultoría de Software
            </span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2.5 border-t border-white/10">
          <a
            href={technicalVisitWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs text-center transition-colors shadow-sm"
          >
            <span>Solicitar Visita Técnica</span>
          </a>
          <button
            type="button"
            id="btn-infobox-coverage"
            class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-200 font-medium text-xs text-center border border-white/10 transition-colors"
          >
            <span>Ver Cobertura</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Safe Touch Footer: Minimalist "Desliza" instruction -->
  <footer 
    id="subterranean-bottom-handle" 
    class="relative z-20 w-full max-w-7xl mx-auto flex items-center justify-center py-2 select-none"
  >
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/50 text-xs font-mono tracking-widest uppercase">
      <span>Desliza</span>
      <svg class="w-3.5 h-3.5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </footer>
</section>

<!-- Global styles for Enterprise Dark Popups & Marker Pulse -->
<style is:global>
  @keyframes drc-hq-pulse {
    0% {
      transform: scale(0.95);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.35);
      opacity: 0.15;
    }
    100% {
      transform: scale(0.95);
      opacity: 0.6;
    }
  }

  .drc-enterprise-popup .maplibregl-popup-content {
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0.75rem !important;
    box-shadow: none !important;
  }

  .drc-enterprise-popup .maplibregl-popup-tip {
    border-top-color: rgba(30, 41, 59, 0.9) !important;
    border-bottom-color: rgba(30, 41, 59, 0.9) !important;
  }

  .drc-enterprise-popup .maplibregl-popup-close-button {
    color: #94a3b8 !important;
    font-size: 1.15rem !important;
    padding: 0.35rem 0.65rem !important;
    right: 0.25rem !important;
    top: 0.25rem !important;
    z-index: 10 !important;
  }

  .drc-enterprise-popup .maplibregl-popup-close-button:hover {
    color: #ffffff !important;
    background: transparent !important;
  }
</style>

<script>
  import { StaticLocationRepository } from '../../../core/infrastructure/repositories/StaticLocationRepository';
  import { MapLibreAdapter } from '../../../core/infrastructure/map/MapLibreAdapter';

  async function mountMapSection(): Promise<void> {
    const canvasElement = document.getElementById('maplibre-canvas');
    if (!canvasElement) return;

    try {
      const repository = new StaticLocationRepository();
      const mapAdapter = new MapLibreAdapter();

      await mapAdapter.init({
        container: 'maplibre-canvas',
        initialCenter: MapLibreAdapter.ASIA_ORIGIN,
        initialZoom: 1.8,
        initialPitch: 0,
        initialBearing: 0
      });

      const nodes = await repository.getInfrastructureNodes();
      mapAdapter.addNodes(nodes);

      // Info Box UI elements
      const infoBox = document.getElementById('corporate-info-box');
      const btnCloseInfoBox = document.getElementById('btn-close-infobox');
      const btnInfoboxCoverage = document.getElementById('btn-infobox-coverage');

      const showInfoBox = () => {
        if (infoBox) {
          infoBox.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          infoBox.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        }
      };

      const hideInfoBox = () => {
        if (infoBox) {
          infoBox.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          infoBox.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        }
      };

      if (btnCloseInfoBox) {
        btnCloseInfoBox.addEventListener('click', hideInfoBox);
      }

      if (btnInfoboxCoverage) {
        btnInfoboxCoverage.addEventListener('click', () => {
          mapAdapter.focusNational();
          hideInfoBox();
        });
      }

      // Cinematic and HQ focus callbacks
      mapAdapter.onCinematicComplete(() => {
        showInfoBox();
      });

      mapAdapter.onHQFocus(() => {
        showInfoBox();
      });

      mapAdapter.onNodeClick((node) => {
        if (node.properties.isHQ || node.properties.type === 'headquarters') {
          showInfoBox();
        } else {
          hideInfoBox();
        }
      });

      // HUD Button Listeners
      const btnFocusHQ = document.getElementById('btn-focus-hq');
      const btnFocusNational = document.getElementById('btn-focus-national');
      const btnResetView = document.getElementById('btn-reset-view');

      if (btnFocusHQ) {
        btnFocusHQ.addEventListener('click', () => {
          mapAdapter.focusHQ();
          showInfoBox();
        });
      }

      if (btnFocusNational) {
        btnFocusNational.addEventListener('click', () => {
          mapAdapter.focusNational();
          hideInfoBox();
        });
      }

      if (btnResetView) {
        btnResetView.addEventListener('click', () => {
          mapAdapter.resetView();
          hideInfoBox();
        });
      }

      // Safe Touch Zones handlers for mobile navigation
      const topHandle = document.getElementById('subterranean-top-handle');
      if (topHandle) {
        let touchStartY = 0;
        topHandle.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) touchStartY = e.touches[0].clientY;
        }, { passive: true });

        topHandle.addEventListener('touchmove', (e) => {
          if (e.touches.length === 1) {
            const deltaY = touchStartY - e.touches[0].clientY;
            if (deltaY < -10) {
              const hero = document.getElementById('hero-cinematic');
              if (hero) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }, { passive: true });

        topHandle.addEventListener('click', () => {
          const hero = document.getElementById('hero-cinematic');
          if (hero) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      const bottomHandle = document.getElementById('subterranean-bottom-handle');
      if (bottomHandle) {
        let touchStartY = 0;
        bottomHandle.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) touchStartY = e.touches[0].clientY;
        }, { passive: true });

        bottomHandle.addEventListener('touchmove', (e) => {
          if (e.touches.length === 1) {
            const deltaY = touchStartY - e.touches[0].clientY;
            if (deltaY > 10) {
              const footer = document.querySelector('footer.snap-section');
              if (footer) footer.scrollIntoView({ behavior: 'smooth', block: 'end' });
            }
          }
        }, { passive: true });
      }

      // Ensure canvas responds dynamically to screen resize or rotation
      window.addEventListener('resize', () => {
        mapAdapter.resize?.();
      });

      // IntersectionObserver for cinematic intro sequence
      const sectionElement = document.getElementById('cobertura');
      let introTriggered = false;

      if (sectionElement && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !introTriggered) {
                introTriggered = true;
                observer.disconnect();
                // Allow the auto-glide/snap transition to settle completely into view
                setTimeout(() => {
                  mapAdapter.runCinematicIntro();
                }, 400);
              }
            });
          },
          { threshold: 0.5 }
        );
        observer.observe(sectionElement);
      } else {
        mapAdapter.runCinematicIntro();
      }

      window.addEventListener('beforeunload', () => {
        mapAdapter.destroy();
      });
    } catch (error) {
      console.error('Failed to initialize MapLibre Enterprise Map:', error);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountMapSection);
  } else {
    mountMapSection();
  }
</script>
