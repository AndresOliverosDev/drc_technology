---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-900 bg-slate-950 py-8 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
    <div class="flex items-center gap-2">
      <img src="/images/logo.png" alt="DRC" class="w-6 h-6 object-contain" />
      <span class="text-slate-400 font-medium">&copy; {currentYear} DRC Technology Solutions. Todos los derechos reservados.</span>
    </div>
    <div class="font-mono text-slate-500">
      Telecomunicaciones &bull; Infraestructura Crítica
    </div>
  </div>
</footer>
